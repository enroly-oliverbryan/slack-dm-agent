{
  "name": "slack-dm-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "recon:collect": "tsx --env-file=.env recon/collect.ts",
    "recon:build": "tsx --env-file=.env recon/build-profile.ts",
    "recon": "pnpm recon:collect && pnpm recon:build && pnpm recon:people",
    "recon:people": "tsx --env-file=.env recon/build-people.ts",
    "test": "tsx --test 'src/**/*.test.ts'",
    "triage": "tsx --env-file=.env src/triage-cli.ts",
    "respond": "tsx --env-file=.env src/respond-cli.ts",
    "audit-log": "tsx src/audit-cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.325",
    "@slack/socket-mode": "^3.2.0",
    "@slack/web-api": "^8.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
